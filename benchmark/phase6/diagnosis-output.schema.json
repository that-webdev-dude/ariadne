{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 6 diagnosis output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rootCause",
    "causalChain",
    "evidence",
    "fixBoundary"
  ],
  "properties": {
    "rootCause": {
      "type": "string",
      "minLength": 1
    },
    "causalChain": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fixBoundary": {
      "type": "string",
      "minLength": 1
    }
  }
}
