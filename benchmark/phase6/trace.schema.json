{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/that-webdev-dude/ariadne/benchmark/phase6/trace.schema.json",
  "title": "Ariadne Phase 6 benchmark trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "benchmarkId",
    "condition",
    "runConfigId",
    "manifestSha256",
    "targetCommit",
    "ariadneCommit",
    "runner",
    "model",
    "startedAt",
    "usage",
    "events"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "benchmarkId": {
      "type": "string",
      "minLength": 1
    },
    "condition": {
      "enum": [
        "control",
        "ariadne"
      ]
    },
    "runConfigId": {
      "type": "string",
      "minLength": 1
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "targetCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "ariadneCommit": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      ]
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "mode"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "id",
        "settings"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "settings": {
          "type": "object"
        }
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputTokens",
        "cachedInputTokens",
        "outputTokens",
        "reasoningOutputTokens"
      ],
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "cachedInputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoningOutputTokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "baseEvent": {
      "type": "object",
      "required": [
        "sequence",
        "elapsedMs",
        "type"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "elapsedMs": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "type": "string"
        }
      }
    },
    "event": {
      "oneOf": [
        {
          "$ref": "#/$defs/toolCall"
        },
        {
          "$ref": "#/$defs/toolResult"
        },
        {
          "$ref": "#/$defs/final"
        }
      ]
    },
    "toolCall": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEvent"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sequence",
            "elapsedMs",
            "type",
            "callId",
            "tool",
            "category",
            "arguments"
          ],
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "elapsedMs": {
              "type": "integer",
              "minimum": 0
            },
            "type": {
              "const": "tool_call"
            },
            "callId": {
              "type": "string",
              "minLength": 1
            },
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "category": {
              "enum": [
                "search",
                "source",
                "ariadne",
                "other"
              ]
            },
            "arguments": {
              "type": "object"
            }
          }
        }
      ]
    },
    "toolResult": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEvent"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sequence",
            "elapsedMs",
            "type",
            "callId",
            "ok",
            "context"
          ],
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "elapsedMs": {
              "type": "integer",
              "minimum": 0
            },
            "type": {
              "const": "tool_result"
            },
            "callId": {
              "type": "string",
              "minLength": 1
            },
            "ok": {
              "type": "boolean"
            },
            "context": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/contextItem"
              }
            }
          }
        }
      ]
    },
    "contextItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "content"
      ],
      "properties": {
        "kind": {
          "enum": [
            "source",
            "search_result",
            "ariadne_result",
            "other"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string"
        },
        "tokenCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "source"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "path"
            ]
          }
        }
      ]
    },
    "final": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEvent"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sequence",
            "elapsedMs",
            "type",
            "content",
            "diagnosis"
          ],
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "elapsedMs": {
              "type": "integer",
              "minimum": 0
            },
            "type": {
              "const": "final"
            },
            "content": {
              "type": "string",
              "minLength": 1
            },
            "diagnosis": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rootCause",
                "causalChain",
                "evidence",
                "fixBoundary"
              ],
              "properties": {
                "rootCause": {
                  "type": "string",
                  "minLength": 1
                },
                "causalChain": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "fixBoundary": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      ]
    }
  }
}
